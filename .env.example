# Bind address for this service's own listener. Empty (default) binds all
# interfaces — needed inside Docker. Set to 127.0.0.1 for local dev: this
# dev Mac has a direct public IP with no NAT, so 0.0.0.0 outside a container
# is reachable from the open internet.
HOST=127.0.0.1
PORT=8000

# Where the SQLite database file lives.
DB_PATH=./onboarding.db

# Shared secret with landingpage-backend. Generate with: openssl rand -base64 32
# Must match ONBOARDING_SERVICE_SECRET on that service exactly — never reuse
# MCP_SERVICE_SECRET or any other credential here.
ONBOARDING_SERVICE_SECRET=<ONBOARDING_SERVICE_SECRET>

# landingpage-backend's base API URL, no trailing slash, e.g.
# http://localhost:8080/api/v1 for local dev.
BACKEND_URL=http://localhost:8080/api/v1

# Public base URL of the onboarding portal pages (landingpage-frontend routes
# that don't exist yet as of this service's initial build — see
# onboarding-service-plan.md, "Where does the portal live?"). No trailing
# slash. Emailed links are built as {PORTAL_BASE_URL}/start?token=... and
# {PORTAL_BASE_URL}/confirm?token=...
PORTAL_BASE_URL=https://kthais.com/onboarding

# Google Workspace domain-wide-delegation service account used to provision
# @kthais.com accounts. Prefer _PATH (a mounted secret file, e.g. a Dokploy
# volume) over the bare JSON var below — multi-line JSON in an env var is
# fragile across .env files and some PaaS UIs. If using the bare var instead,
# either the raw JSON or a base64-encoded version is accepted.
GOOGLE_ADMIN_SERVICE_ACCOUNT_JSON_PATH=<path to service account JSON key file>
# GOOGLE_ADMIN_SERVICE_ACCOUNT_JSON=<raw or base64-encoded service account JSON>

# The Workspace super-admin email the service account impersonates via
# domain-wide delegation (Admin Console -> Security -> API Controls ->
# Domain-wide Delegation must authorize this service account for exactly
# the admin.directory.user and admin.directory.group.member scopes).
GOOGLE_ADMIN_IMPERSONATE_AS=<admin@kthais.com>

# Mattermost instance base URL, no trailing slash.
MATTERMOST_URL=<https://mattermost.kthais.com>

# A dedicated bot account's token (not an admin personal access token —
# deliberate least-privilege choice, see onboarding-service-plan.md).
# Grant it the minimum team-level permission needed to invite members, not
# System Admin.
MATTERMOST_BOT_TOKEN=<MATTERMOST_BOT_TOKEN>

# The KTHAIS team's id within the Mattermost instance — looked up from that
# instance, not derivable from anything else this service knows.
MATTERMOST_TEAM_ID=<MATTERMOST_TEAM_ID>
